# RF46-G38-F01 simulator-only startup/linker/vector firmware artifact.
rule link_reference_board
  command = mkdir -p $$(dirname $out) && $ld -m elf_x86_64 -nostdlib -z noexecstack --build-id=none -T runtime/embedded/nebo_reference_board_sim_v1.ld -o $out $in
  description = LD-BOARD $out
  restat = 1

rule binary_image
  command = mkdir -p $$(dirname $out) && objcopy -O binary $in $out
  description = OBJCOPY $out
  restat = 1

build $builddir/obj/rf46_g38_reference_startup.o: nasm runtime/embedded/nebo_reference_board_sim_v1_startup.asm
build $builddir/obj/examples/rf46-g38/reference_board_firmware.o: nasm examples/evolution/rf46-g38/reference_board_firmware.asm
build $builddir/examples/rf46-g38/reference_board_firmware.elf: link_reference_board $builddir/obj/rf46_g38_reference_startup.o $builddir/obj/examples/rf46-g38/reference_board_firmware.o | runtime/embedded/nebo_reference_board_sim_v1.ld
build $builddir/examples/rf46-g38/reference_board_firmware.bin: binary_image $builddir/examples/rf46-g38/reference_board_firmware.elf
build rf46-g38-f01-firmware: phony $builddir/examples/rf46-g38/reference_board_firmware.elf $builddir/examples/rf46-g38/reference_board_firmware.bin


