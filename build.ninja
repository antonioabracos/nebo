ninja_required_version = 1.11

builddir = build
nasm = nasm
ld = ld

nasm_flags = -f elf64 -Wall -Werror -I./
ld_flags = -m elf_x86_64 -nostdlib -z noexecstack --build-id=none

rule nasm
  command = mkdir -p $$(dirname $out) && $nasm $nasm_flags -o $out $in
  description = NASM $in
  restat = 1

rule nasm_practical
  command = python3 -B scripts/runtime_sections.py assemble $nasm $nasm_flags -DNEBO_RUNTIME_PRACTICAL_IO=1 -o $out $in
  description = NASM-PRACTICAL $in
  restat = 1

rule nasm_typography_baseline
  command = mkdir -p $$(dirname $out) && $nasm $nasm_flags -DNEBO_LIVE_TYPOGRAPHY_PROFILE=0 -o $out $in
  description = NASM-TYPOGRAPHY-BASELINE $in
  restat = 1

rule nasm_typography_compact
  command = mkdir -p $$(dirname $out) && $nasm $nasm_flags -DNEBO_LIVE_TYPOGRAPHY_PROFILE=1 -o $out $in
  description = NASM-TYPOGRAPHY-A $in
  restat = 1

rule nasm_typography_balanced
  command = mkdir -p $$(dirname $out) && $nasm $nasm_flags -DNEBO_LIVE_TYPOGRAPHY_PROFILE=2 -o $out $in
  description = NASM-TYPOGRAPHY-B $in
  restat = 1

rule nasm_typography_crisp
  command = mkdir -p $$(dirname $out) && $nasm $nasm_flags -DNEBO_LIVE_TYPOGRAPHY_PROFILE=3 -o $out $in
  description = NASM-TYPOGRAPHY-C $in
  restat = 1

rule nasm_typography_professional
  command = mkdir -p $$(dirname $out) && $nasm $nasm_flags -DNEBO_LIVE_TYPOGRAPHY_PROFILE=4 -o $out $in
  description = NASM-TYPOGRAPHY-D $in
  restat = 1

rule nasm_typography_professional_d1
  command = mkdir -p $$(dirname $out) && $nasm $nasm_flags -DNEBO_LIVE_TYPOGRAPHY_PROFILE=5 -o $out $in
  description = NASM-TYPOGRAPHY-D1 $in
  restat = 1

rule nasm_typography_professional_d2
  command = mkdir -p $$(dirname $out) && $nasm $nasm_flags -DNEBO_LIVE_TYPOGRAPHY_PROFILE=6 -o $out $in
  description = NASM-TYPOGRAPHY-D2 $in
  restat = 1

rule nasm_typography_palette_a
  command = mkdir -p $$(dirname $out) && $nasm $nasm_flags -DNEBO_LIVE_TYPOGRAPHY_PROFILE=6 -DNEBO_LIVE_CONTENT_BACKGROUND_COLOR=0xff151a20 -o $out $in
  description = NASM-PALETTE-A $in
  restat = 1

rule nasm_typography_palette_b
  command = mkdir -p $$(dirname $out) && $nasm $nasm_flags -DNEBO_LIVE_TYPOGRAPHY_PROFILE=6 -DNEBO_LIVE_CONTENT_BACKGROUND_COLOR=0xff1b1e23 -o $out $in
  description = NASM-PALETTE-B $in
  restat = 1

rule nasm_typography_palette_c
  command = mkdir -p $$(dirname $out) && $nasm $nasm_flags -DNEBO_LIVE_TYPOGRAPHY_PROFILE=6 -DNEBO_LIVE_CONTENT_BACKGROUND_COLOR=0xff20242a -o $out $in
  description = NASM-PALETTE-C $in
  restat = 1

rule nasm_typography_palette_d
  command = mkdir -p $$(dirname $out) && $nasm $nasm_flags -DNEBO_LIVE_TYPOGRAPHY_PROFILE=6 -DNEBO_LIVE_CONTENT_BACKGROUND_COLOR=0xff18212c -o $out $in
  description = NASM-PALETTE-D $in
  restat = 1

rule nasm_visual_unified
  command = mkdir -p $$(dirname $out) && $nasm $nasm_flags -DNEBO_LIVE_TYPOGRAPHY_PROFILE=7 -DNEBO_LIVE_CONTENT_BACKGROUND_COLOR=0xff1b1e23 -o $out $in
  description = NASM-VISUAL-UNIFIED $in
  restat = 1

rule verify_professional_atlas
  command = mkdir -p $$(dirname $out) && python3 -B scripts/console-visual-polish/generate-professional-atlas.py --font third_party/fonts/adobe-source-code-pro/SourceCodePro-Regular.ttf --license third_party/fonts/adobe-source-code-pro/LICENSE.md --output runtime/console/live/nebo_console_mono_atlas.inc --check > $out
  description = VERIFY-NEBO-CONSOLE-MONO-ATLAS
  restat = 1

rule relocatable_link
  command = python3 -B scripts/runtime_sections.py link $out $in
  description = LD-RELOC $out
  restat = 1

rule link
  command = mkdir -p $$(dirname $out) && $ld $ld_flags -o $out $in
  description = LD $out
  restat = 1

rule c04_f07_cli_validation
  command = bash tests/c04/f07/validate-cli.sh > $out
  description = C04-F07-CLI-VALIDATION

rule false_green_buffer_route_regression
  command = mkdir -p $$(dirname $out) && bash tests/regressions/false-green-buffer-route/validate.sh > $out
  description = FALSE-GREEN-BUFFER-ROUTE-REGRESSION
  restat = 1

rule rf148_conformance
  command = mkdir -p $$(dirname $out) && $in > $out
  description = RF148-CONFORMANCE $in
  restat = 1

rule rf166_conformance
  command = mkdir -p $$(dirname $out) && $in > $out
  description = RF166-CONFORMANCE $in
  restat = 1

build $builddir/obj/entry.o: nasm compiler/driver/bootstrap/entry.asm
