; Reject any intersection between two bounded buffers, including partial
; aliases. The caller supplies a volatile scratch register and failure label.
%macro NEBOC_RF166_REJECT_OVERLAP 6
    mov %6,%1
    add %6,%2
    jc %5
    cmp %3,%6
    jae %%clear
    mov %6,%3
    add %6,%4
    jc %5
    cmp %1,%6
    jb %5
%%clear:
%endmacro

