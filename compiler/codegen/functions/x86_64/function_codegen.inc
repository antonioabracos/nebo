%define NEBOC_FUNCTION_CODEGEN_CURRENT_RETURN_TYPE_OFFSET 1824
%define NEBOC_FUNCTION_CODEGEN_CURRENT_SRET_SLOT_OFFSET 1832
; NPT-LANG-35 compiler-private recursion state.  The selected symbol and
; declaration identify the one admitted SCC1 self edge; the per-resolution
