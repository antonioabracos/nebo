%define NEBOC_COMPLETION_PACKAGE_COUNT_OFFSET 120
%define NEBOC_COMPLETION_CANDIDATE_COUNT_OFFSET 128
%define NEBOC_COMPLETION_ELIGIBLE_COUNT_OFFSET 136
%define NEBOC_COMPLETION_PRIVATE_REJECTED_OFFSET 144
%define NEBOC_COMPLETION_EFFECT_REJECTED_OFFSET 152
%define NEBOC_COMPLETION_CAPABILITY_REJECTED_OFFSET 160
%define NEBOC_COMPLETION_TARGET_REJECTED_OFFSET 168
%define NEBOC_COMPLETION_EDITION_REJECTED_OFFSET 176
%define NEBOC_COMPLETION_CONSTRAINT_REJECTED_OFFSET 184
%define NEBOC_COMPLETION_RANK_DIGEST_OFFSET 192
%define NEBOC_COMPLETION_SELECTED_SYMBOL_OFFSET 200
%define NEBOC_COMPLETION_DOC_HANDLE_OFFSET 208
%define NEBOC_COMPLETION_IMPORT_DIGEST_OFFSET 216
%define NEBOC_COMPLETION_MEMORY_BYTES_OFFSET 224
%define NEBOC_COMPLETION_MEMORY_BUDGET_OFFSET 232
%define NEBOC_COMPLETION_DEADLINE_MS_OFFSET 240
%define NEBOC_COMPLETION_OBSERVED_MS_OFFSET 248
%define NEBOC_COMPLETION_RECEIVER_EVALUATIONS_OFFSET 256
%define NEBOC_COMPLETION_MALFORMED_OFFSET 264
%define NEBOC_COMPLETION_STALE_OFFSET 272
%define NEBOC_COMPLETION_RESERVED_OFFSET 280
