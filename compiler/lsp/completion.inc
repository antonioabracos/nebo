%define NEBOC_COMPLETION_REQUEST_QWORDS 36

%define NEBOC_COMPLETION_OUTPUT_STATUS_OFFSET 0
%define NEBOC_COMPLETION_OUTPUT_OPERATION_OFFSET 8
%define NEBOC_COMPLETION_OUTPUT_DIGEST_OFFSET 16
%define NEBOC_COMPLETION_OUTPUT_RECEIVER_TYPE_OFFSET 24
%define NEBOC_COMPLETION_OUTPUT_CANDIDATES_OFFSET 32
%define NEBOC_COMPLETION_OUTPUT_ELIGIBLE_OFFSET 40
%define NEBOC_COMPLETION_OUTPUT_RANK_DIGEST_OFFSET 48
%define NEBOC_COMPLETION_OUTPUT_REVISION_OFFSET 56
%define NEBOC_COMPLETION_RESULT_SIZE 64

%define NEBOC_COMPLETION_OP_CONTEXT 1
%define NEBOC_COMPLETION_OP_RECEIVER 2
%define NEBOC_COMPLETION_OP_MEMBERS 3
%define NEBOC_COMPLETION_OP_AUTO_IMPORT 4
%define NEBOC_COMPLETION_OP_FILTER 5
%define NEBOC_COMPLETION_OP_RANK 6
%define NEBOC_COMPLETION_OP_RESOLVE 7

%define NEBOC_COMPLETION_FLAG_SNAPSHOT 1
%define NEBOC_COMPLETION_FLAG_TYPECHECKED 2
%define NEBOC_COMPLETION_FLAG_INDEX 4
%define NEBOC_COMPLETION_FLAG_PRIVATE_FILTERED 8
%define NEBOC_COMPLETION_FLAG_NO_GRANTS 16
%define NEBOC_COMPLETION_FLAG_DETERMINISTIC 32
%define NEBOC_COMPLETION_FLAG_ATOMIC 64
%define NEBOC_COMPLETION_FLAG_EXPLICIT_EDIT 128
%define NEBOC_COMPLETION_FLAG_DOC 256
%define NEBOC_COMPLETION_FLAG_RECOVERY 512
%define NEBOC_COMPLETION_FLAG_KNOWN_MASK 1023

%define NEBOC_COMPLETION_MAX_SOURCE_BYTES 16384
%define NEBOC_COMPLETION_MAX_CANDIDATES 256
%define NEBOC_COMPLETION_MAX_MEMORY_BYTES 1048576
%define NEBOC_COMPLETION_MAX_DEADLINE_MS 1000

%define NEBOC_COMPLETION_STATUS_ARGUMENT 1
%define NEBOC_COMPLETION_STATUS_CONTRACT 2
