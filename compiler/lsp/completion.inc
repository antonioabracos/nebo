%define NEBOC_COMPLETION_STATUS_MISMATCH 4
%define NEBOC_COMPLETION_STATUS_LIMIT 5

%macro COMPLETION_VALIDATE_COMMON 1
 test rdi,rdi
 jz %%argument
 test rsi,rsi
 jz %%argument
 test rdi,7
 jnz %%argument
 test rsi,7
 jnz %%argument
 mov rax,NEBOC_COMPLETION_MAGIC
 cmp qword [rdi+NEBOC_COMPLETION_MAGIC_OFFSET],rax
 jne %%contract
 cmp qword [rdi+NEBOC_COMPLETION_VERSION_OFFSET],NEBOC_COMPLETION_VERSION
 jne %%contract
 cmp qword [rdi+NEBOC_COMPLETION_OPERATION_OFFSET],%1
 jne %%contract
 mov rax,[rdi+NEBOC_COMPLETION_FLAGS_OFFSET]
 test rax,~NEBOC_COMPLETION_FLAG_KNOWN_MASK
 jnz %%contract
 test rax,NEBOC_COMPLETION_FLAG_SNAPSHOT
 jz %%contract
 test rax,NEBOC_COMPLETION_FLAG_ATOMIC
 jz %%contract
 cmp qword [rdi+NEBOC_COMPLETION_SNAPSHOT_OFFSET],0
 je %%contract
 cmp qword [rdi+NEBOC_COMPLETION_REVISION_OFFSET],0
 je %%contract
 mov rax,[rdi+NEBOC_COMPLETION_SOURCE_BYTES_OFFSET]
 test rax,rax
 jz %%limit
 cmp rax,NEBOC_COMPLETION_MAX_SOURCE_BYTES
 ja %%limit
 cmp qword [rdi+NEBOC_COMPLETION_POSITION_OFFSET],rax
 ja %%contract
 mov rax,[rdi+NEBOC_COMPLETION_CANDIDATE_COUNT_OFFSET]
 cmp rax,NEBOC_COMPLETION_MAX_CANDIDATES
 ja %%limit
 cmp qword [rdi+NEBOC_COMPLETION_ELIGIBLE_COUNT_OFFSET],rax
 ja %%mismatch
 xor rax,rax
 add rax,[rdi+NEBOC_COMPLETION_CORE_COUNT_OFFSET]
 jc %%limit
 add rax,[rdi+NEBOC_COMPLETION_PRELUDE_COUNT_OFFSET]
 jc %%limit
 add rax,[rdi+NEBOC_COMPLETION_IMPORTED_COUNT_OFFSET]
 jc %%limit
 add rax,[rdi+NEBOC_COMPLETION_AUTO_IMPORT_COUNT_OFFSET]
 jc %%limit
 cmp rax,[rdi+NEBOC_COMPLETION_CANDIDATE_COUNT_OFFSET]
 jne %%mismatch
 mov rax,[rdi+NEBOC_COMPLETION_PACKAGE_COUNT_OFFSET]
 cmp rax,[rdi+NEBOC_COMPLETION_AUTO_IMPORT_COUNT_OFFSET]
 ja %%mismatch
 xor rax,rax
 add rax,[rdi+NEBOC_COMPLETION_PRIVATE_REJECTED_OFFSET]
 jc %%limit
 add rax,[rdi+NEBOC_COMPLETION_EFFECT_REJECTED_OFFSET]
 jc %%limit
 add rax,[rdi+NEBOC_COMPLETION_CAPABILITY_REJECTED_OFFSET]
 jc %%limit
 add rax,[rdi+NEBOC_COMPLETION_TARGET_REJECTED_OFFSET]
 jc %%limit
 add rax,[rdi+NEBOC_COMPLETION_EDITION_REJECTED_OFFSET]
 jc %%limit
 add rax,[rdi+NEBOC_COMPLETION_CONSTRAINT_REJECTED_OFFSET]
 jc %%limit
 add rax,[rdi+NEBOC_COMPLETION_ELIGIBLE_COUNT_OFFSET]
 jc %%limit
 cmp rax,[rdi+NEBOC_COMPLETION_CANDIDATE_COUNT_OFFSET]
 jne %%mismatch
 mov rax,[rdi+NEBOC_COMPLETION_MEMORY_BUDGET_OFFSET]
 test rax,rax
 jz %%limit
 cmp rax,NEBOC_COMPLETION_MAX_MEMORY_BYTES
 ja %%limit
 cmp qword [rdi+NEBOC_COMPLETION_MEMORY_BYTES_OFFSET],rax
 ja %%limit
 mov rax,[rdi+NEBOC_COMPLETION_DEADLINE_MS_OFFSET]
 test rax,rax
 jz %%limit
 cmp rax,NEBOC_COMPLETION_MAX_DEADLINE_MS
 ja %%limit
 cmp qword [rdi+NEBOC_COMPLETION_OBSERVED_MS_OFFSET],rax
 ja %%limit
 cmp qword [rdi+NEBOC_COMPLETION_RECEIVER_EVALUATIONS_OFFSET],1
 ja %%contract
 cmp qword [rdi+NEBOC_COMPLETION_MALFORMED_OFFSET],0
 jne %%contract
 cmp qword [rdi+NEBOC_COMPLETION_STALE_OFFSET],0
 jne %%policy
 cmp qword [rdi+NEBOC_COMPLETION_RESERVED_OFFSET],0
 jne %%contract
 jmp %%valid
%%argument:
 mov eax,NEBOC_COMPLETION_STATUS_ARGUMENT
 ret
%%contract:
 mov eax,NEBOC_COMPLETION_STATUS_CONTRACT
 ret
%%policy:
 mov eax,NEBOC_COMPLETION_STATUS_POLICY
 ret
%%mismatch:
 mov eax,NEBOC_COMPLETION_STATUS_MISMATCH
 ret
%%limit:
 mov eax,NEBOC_COMPLETION_STATUS_LIMIT
 ret
%%valid:
%endmacro

%macro COMPLETION_REQUIRE_FLAGS 1
 mov rax,[rdi+NEBOC_COMPLETION_FLAGS_OFFSET]
 and rax,%1
 cmp rax,%1
 je %%present
 mov eax,NEBOC_COMPLETION_STATUS_POLICY
 ret
%%present:
%endmacro

%macro COMPLETION_PUBLISH 0
 mov rax,[rdi+NEBOC_COMPLETION_SNAPSHOT_OFFSET]
 xor rax,[rdi+NEBOC_COMPLETION_RECEIVER_TYPE_OFFSET]
 xor rax,[rdi+NEBOC_COMPLETION_RANK_DIGEST_OFFSET]
 xor rax,[rdi+NEBOC_COMPLETION_SELECTED_SYMBOL_OFFSET]
 mov qword [rsi+NEBOC_COMPLETION_OUTPUT_STATUS_OFFSET],0
 mov rcx,[rdi+NEBOC_COMPLETION_OPERATION_OFFSET]
 mov [rsi+NEBOC_COMPLETION_OUTPUT_OPERATION_OFFSET],rcx
 mov [rsi+NEBOC_COMPLETION_OUTPUT_DIGEST_OFFSET],rax
 mov rcx,[rdi+NEBOC_COMPLETION_RECEIVER_TYPE_OFFSET]
 mov [rsi+NEBOC_COMPLETION_OUTPUT_RECEIVER_TYPE_OFFSET],rcx
 mov rcx,[rdi+NEBOC_COMPLETION_CANDIDATE_COUNT_OFFSET]
 mov [rsi+NEBOC_COMPLETION_OUTPUT_CANDIDATES_OFFSET],rcx
 mov rcx,[rdi+NEBOC_COMPLETION_ELIGIBLE_COUNT_OFFSET]
 mov [rsi+NEBOC_COMPLETION_OUTPUT_ELIGIBLE_OFFSET],rcx
 mov rcx,[rdi+NEBOC_COMPLETION_RANK_DIGEST_OFFSET]
 mov [rsi+NEBOC_COMPLETION_OUTPUT_RANK_DIGEST_OFFSET],rcx
 mov rcx,[rdi+NEBOC_COMPLETION_REVISION_OFFSET]
 mov [rsi+NEBOC_COMPLETION_OUTPUT_REVISION_OFFSET],rcx
 xor eax,eax
 ret
%endmacro

%endif
