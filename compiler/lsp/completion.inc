; RF166-G161 pointer-free receiver-completion ABI.
; The canonical parser/typechecker/index adapters publish only observed facts;
; these Assembly owners validate revision, policy and bounded accounting before
; any caller-owned result is changed.
%ifndef NEBOC_COMPLETION_INC
%define NEBOC_COMPLETION_INC 1

%define NEBOC_COMPLETION_MAGIC 0x313631504d4f434e ; "NCOMP161"
%define NEBOC_COMPLETION_VERSION 1

%define NEBOC_COMPLETION_MAGIC_OFFSET 0
%define NEBOC_COMPLETION_VERSION_OFFSET 8
%define NEBOC_COMPLETION_OPERATION_OFFSET 16
%define NEBOC_COMPLETION_FLAGS_OFFSET 24
%define NEBOC_COMPLETION_SNAPSHOT_OFFSET 32
%define NEBOC_COMPLETION_REVISION_OFFSET 40
%define NEBOC_COMPLETION_POSITION_OFFSET 48
%define NEBOC_COMPLETION_SOURCE_BYTES_OFFSET 56
%define NEBOC_COMPLETION_RECEIVER_TYPE_OFFSET 64
%define NEBOC_COMPLETION_CONSTRAINTS_OFFSET 72
