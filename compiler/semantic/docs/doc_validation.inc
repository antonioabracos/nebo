%define NEBOC_DOCV_DEPRECATED_OFFSET 240
%define NEBOC_DOCV_CURRENT_VERSION_OFFSET 248
%define NEBOC_DOCV_DOC_TARGET_OFFSET 256
%define NEBOC_DOCV_ACTIVE_TARGET_OFFSET 264
%define NEBOC_DOCV_DOC_SPAN_OFFSET 272
%define NEBOC_DOCV_DECL_SPAN_OFFSET 280
%define NEBOC_DOCV_SIGNATURE_HASH_OFFSET 288
%define NEBOC_DOCV_PREVIOUS_SIGNATURE_HASH_OFFSET 296
%define NEBOC_DOCV_POLICY_FLAGS_OFFSET 304
%define NEBOC_DOCV_VISIBILITY_OFFSET 312
%define NEBOC_DOCV_REQUEST_SIZE 320
%define NEBOC_DOCV_REQUEST_QWORDS 40
