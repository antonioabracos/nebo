%macro DOCV_VALIDATE_REQUEST 1
 test rdi,rdi
 jz %%argument
 test rsi,rsi
 jz %%argument
 test rdi,7
 jnz %%argument
 test rsi,7
 jnz %%argument
 mov rax,NEBOC_DOC_VALIDATION_MAGIC
 cmp qword [rdi+NEBOC_DOCV_MAGIC_OFFSET],rax
 jne %%contract
 cmp qword [rdi+NEBOC_DOCV_VERSION_OFFSET],NEBOC_DOC_VALIDATION_VERSION
 jne %%contract
 cmp qword [rdi+NEBOC_DOCV_DOC_PARAM_COUNT_OFFSET],NEBOC_DOCV_MAX_PARAMETERS
 ja %%contract
 cmp qword [rdi+NEBOC_DOCV_SYMBOL_PARAM_COUNT_OFFSET],NEBOC_DOCV_MAX_PARAMETERS
 ja %%contract
 mov rax,[rdi+NEBOC_DOCV_POLICY_FLAGS_OFFSET]
 test rax,~NEBOC_DOCV_POLICY_KNOWN_MASK
 jnz %%contract
 mov rax,[rdi+NEBOC_DOCV_VISIBILITY_OFFSET]
 cmp rax,NEBOC_DOCV_VISIBILITY_PUBLIC
 jb %%contract
 cmp rax,NEBOC_DOCV_VISIBILITY_GENERATED
 ja %%contract
 jmp %1
%%argument:
 mov eax,NEBOC_DOCV_STATUS_ARGUMENT
 ret
%%contract:
 mov eax,NEBOC_DOCV_STATUS_CONTRACT
 ret
%endmacro

%macro DOCV_PUBLISH_NONE 0
 xor eax,eax
 mov ecx,NEBOC_DOCV_ISSUE_QWORDS
 mov rdi,rsi
 rep stosq
 xor eax,eax
 ret
%endmacro

%macro DOCV_PUBLISH_ISSUE 5
 mov qword [rsi+NEBOC_DOCV_ISSUE_CODE_OFFSET],%1
 mov qword [rsi+NEBOC_DOCV_ISSUE_SEVERITY_OFFSET],%2
 mov rax,[rdi+NEBOC_DOCV_SYMBOL_ID_OFFSET]
 mov [rsi+NEBOC_DOCV_ISSUE_SYMBOL_ID_OFFSET],rax
 mov rax,[rdi+NEBOC_DOCV_DOC_SPAN_OFFSET]
 mov [rsi+NEBOC_DOCV_ISSUE_PRIMARY_SPAN_OFFSET],rax
 mov rax,[rdi+NEBOC_DOCV_DECL_SPAN_OFFSET]
 mov [rsi+NEBOC_DOCV_ISSUE_RELATED_SPAN_OFFSET],rax
 mov qword [rsi+NEBOC_DOCV_ISSUE_EXPECTED_OFFSET],%3
 mov qword [rsi+NEBOC_DOCV_ISSUE_OBSERVED_OFFSET],%4
 mov qword [rsi+NEBOC_DOCV_ISSUE_FIX_KIND_OFFSET],%5
 xor eax,eax
 ret
%endmacro

