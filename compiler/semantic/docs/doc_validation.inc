%define NEBOC_DOCV_ISSUE_CODE_OFFSET 0
%define NEBOC_DOCV_ISSUE_SEVERITY_OFFSET 8
%define NEBOC_DOCV_ISSUE_SYMBOL_ID_OFFSET 16
%define NEBOC_DOCV_ISSUE_PRIMARY_SPAN_OFFSET 24
%define NEBOC_DOCV_ISSUE_RELATED_SPAN_OFFSET 32
%define NEBOC_DOCV_ISSUE_EXPECTED_OFFSET 40
%define NEBOC_DOCV_ISSUE_OBSERVED_OFFSET 48
%define NEBOC_DOCV_ISSUE_FIX_KIND_OFFSET 56
%define NEBOC_DOCV_ISSUE_SIZE 64
%define NEBOC_DOCV_ISSUE_QWORDS 8
%define NEBOC_DOCV_VALIDATOR_COUNT 7
%define NEBOC_DOCV_REPORT_SIZE (NEBOC_DOCV_VALIDATOR_COUNT*NEBOC_DOCV_ISSUE_SIZE)

%define NEBOC_DOCV_SEVERITY_WARNING 1
