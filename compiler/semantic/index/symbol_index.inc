 jz %%limit
 cmp rax,NEBOC_INDEX_MAX_DEADLINE_MS
 ja %%limit
 cmp qword [rdi+NEBOC_INDEX_OBSERVED_MS_OFFSET],rax
 ja %%limit
 cmp qword [rdi+NEBOC_INDEX_MALFORMED_OFFSET],0
