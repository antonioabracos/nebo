%ifndef NEBOC_CORE_OPTION_RANGE_FLOW_REGISTRY_INC
%define NEBOC_CORE_OPTION_RANGE_FLOW_REGISTRY_INC 1

; G124 closed semantic Registry slice. Stable ID 042 is absent by contract.
%define NEBOC_CORE_ORF_REGISTRY_SCHEMA_VERSION 1
%define NEBOC_CORE_ORF_REGISTRY_ENTRY_COUNT 9

%define NEBOC_CORE_ORF_ENTRY_ID_OFFSET 0
%define NEBOC_CORE_ORF_ENTRY_TOKEN_OFFSET 8
%define NEBOC_CORE_ORF_ENTRY_FIXITY_OFFSET 16
%define NEBOC_CORE_ORF_ENTRY_CONTEXTS_OFFSET 24
%define NEBOC_CORE_ORF_ENTRY_PRECEDENCE_OFFSET 32
%define NEBOC_CORE_ORF_ENTRY_ASSOCIATIVITY_OFFSET 40
%define NEBOC_CORE_ORF_ENTRY_PROTOCOL_OFFSET 48
%define NEBOC_CORE_ORF_ENTRY_STATE_OFFSET 56
%define NEBOC_CORE_ORF_ENTRY_FLAGS_OFFSET 64
%define NEBOC_CORE_ORF_ENTRY_SIZE 72

%define NEBOC_CORE_ORF_PROTOCOL_RESULT_PROPAGATE 101
%define NEBOC_CORE_ORF_PROTOCOL_OPTION_COALESCE 102
%define NEBOC_CORE_ORF_PROTOCOL_OPTION_MEMBER 103
%define NEBOC_CORE_ORF_PROTOCOL_OPTION_ASSIGN_IF_NONE 104
%define NEBOC_CORE_ORF_PROTOCOL_RANGE 105
%define NEBOC_CORE_ORF_PROTOCOL_LATERAL 106

%define NEBOC_CORE_ORF_FLAG_EXACT_TYPES 1
%define NEBOC_CORE_ORF_FLAG_RHS_LAZY 2
%define NEBOC_CORE_ORF_FLAG_CONTEXTUAL 4
%define NEBOC_CORE_ORF_FLAG_EARLY_RETURN 8
%define NEBOC_CORE_ORF_FLAG_ATOMIC_STORE 16
%define NEBOC_CORE_ORF_FLAG_UNICODE 32
%define NEBOC_CORE_ORF_FLAG_NONASSOCIATIVE 64
%define NEBOC_CORE_ORF_FLAG_READ_ONLY 128

; token register, Registry-ID register, rejection label
%macro NEBOC_CORE_ORF_CLASSIFY 3
 cmp %1,NEBOC_TOKEN_QUESTION
 je %%question
 cmp %1,NEBOC_TOKEN_COALESCE
 je %%coalesce
 cmp %1,NEBOC_TOKEN_OPTIONAL_CHAIN
 je %%chain
 cmp %1,NEBOC_TOKEN_OPTION_ASSIGN
 je %%assign
 cmp %1,NEBOC_TOKEN_RANGE_INCLUSIVE
 je %%range_inclusive
 cmp %1,NEBOC_TOKEN_RANGE_EXCLUSIVE_END
 je %%range_exclusive_end
 cmp %1,NEBOC_TOKEN_RANGE_EXCLUSIVE_START
 je %%range_exclusive_start
 cmp %1,NEBOC_TOKEN_RANGE_EXCLUSIVE
 je %%range_exclusive
 cmp %1,NEBOC_TOKEN_LATERAL_FLOW
 je %%lateral
 jmp %3
%%question: mov %2,NEBOC_OPERATOR_ID_NSR_CORE_038
 jmp %%done
%%coalesce: mov %2,NEBOC_OPERATOR_ID_NSR_CORE_039
 jmp %%done
%%chain: mov %2,NEBOC_OPERATOR_ID_NSR_CORE_040
 jmp %%done
%%assign: mov %2,NEBOC_OPERATOR_ID_NSR_CORE_041
 jmp %%done
%%range_inclusive: mov %2,NEBOC_OPERATOR_ID_NSR_CORE_043
 jmp %%done
%%range_exclusive_end: mov %2,NEBOC_OPERATOR_ID_NSR_CORE_044
 jmp %%done
%%range_exclusive_start: mov %2,NEBOC_OPERATOR_ID_NSR_CORE_045
 jmp %%done
%%range_exclusive: mov %2,NEBOC_OPERATOR_ID_NSR_CORE_046
 jmp %%done
%%lateral: mov %2,NEBOC_OPERATOR_ID_NSR_CORE_047
%%done:
%endmacro

%if NEBOC_CORE_ORF_ENTRY_SIZE & 7
 %error "G124 Registry ABI must be eight-byte aligned"
%endif

%endif
