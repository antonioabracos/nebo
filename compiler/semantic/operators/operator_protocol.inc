%ifndef NEBOC_OPERATOR_PROTOCOL_INC
%define NEBOC_OPERATOR_PROTOCOL_INC 1

%define NEBOC_OPERATOR_PROTOCOL_SCHEMA_VERSION 1

; Closed protocol identities. User types may implement these identities but
; cannot create lexemes, fixity, precedence or new protocol numbers.
%define NEBOC_OPERATOR_PROTOCOL_ADD 1
%define NEBOC_OPERATOR_PROTOCOL_SUBTRACT 2
%define NEBOC_OPERATOR_PROTOCOL_MULTIPLY 3
%define NEBOC_OPERATOR_PROTOCOL_DIVIDE 4
%define NEBOC_OPERATOR_PROTOCOL_REMAINDER 5
%define NEBOC_OPERATOR_PROTOCOL_POWER 6
%define NEBOC_OPERATOR_PROTOCOL_NEGATE 7
%define NEBOC_OPERATOR_PROTOCOL_LOGICAL_NOT 8
%define NEBOC_OPERATOR_PROTOCOL_LOGICAL_AND 9
%define NEBOC_OPERATOR_PROTOCOL_LOGICAL_OR 10
%define NEBOC_OPERATOR_PROTOCOL_XOR 11
%define NEBOC_OPERATOR_PROTOCOL_EQUAL 12
%define NEBOC_OPERATOR_PROTOCOL_ORDER 13
%define NEBOC_OPERATOR_PROTOCOL_COALESCE 14
%define NEBOC_OPERATOR_PROTOCOL_ASSIGN 15
%define NEBOC_OPERATOR_PROTOCOL_COUNT 15

; OperatorKind is the normalized Typed AST/HIR/LIR identity.  Version 1 keeps
; a deliberate one-to-one mapping with OperatorProtocol so downstream stages
; never recover semantics from a lexeme or token spelling.
%define NEBOC_OPERATOR_KIND_ADD NEBOC_OPERATOR_PROTOCOL_ADD
%define NEBOC_OPERATOR_KIND_SUBTRACT NEBOC_OPERATOR_PROTOCOL_SUBTRACT
%define NEBOC_OPERATOR_KIND_MULTIPLY NEBOC_OPERATOR_PROTOCOL_MULTIPLY
%define NEBOC_OPERATOR_KIND_DIVIDE NEBOC_OPERATOR_PROTOCOL_DIVIDE
%define NEBOC_OPERATOR_KIND_REMAINDER NEBOC_OPERATOR_PROTOCOL_REMAINDER
%define NEBOC_OPERATOR_KIND_POWER NEBOC_OPERATOR_PROTOCOL_POWER
%define NEBOC_OPERATOR_KIND_NEGATE NEBOC_OPERATOR_PROTOCOL_NEGATE
%define NEBOC_OPERATOR_KIND_LOGICAL_NOT NEBOC_OPERATOR_PROTOCOL_LOGICAL_NOT
%define NEBOC_OPERATOR_KIND_LOGICAL_AND NEBOC_OPERATOR_PROTOCOL_LOGICAL_AND
%define NEBOC_OPERATOR_KIND_LOGICAL_OR NEBOC_OPERATOR_PROTOCOL_LOGICAL_OR
%define NEBOC_OPERATOR_KIND_XOR NEBOC_OPERATOR_PROTOCOL_XOR
%define NEBOC_OPERATOR_KIND_EQUAL NEBOC_OPERATOR_PROTOCOL_EQUAL
%define NEBOC_OPERATOR_KIND_ORDER NEBOC_OPERATOR_PROTOCOL_ORDER
%define NEBOC_OPERATOR_KIND_COALESCE NEBOC_OPERATOR_PROTOCOL_COALESCE
%define NEBOC_OPERATOR_KIND_ASSIGN NEBOC_OPERATOR_PROTOCOL_ASSIGN
%define NEBOC_OPERATOR_KIND_COUNT NEBOC_OPERATOR_PROTOCOL_COUNT

%define NEBOC_OPERATOR_ARITY_UNARY 1
%define NEBOC_OPERATOR_ARITY_BINARY 2

%define NEBOC_OPERATOR_EFFECT_EAGER 1
%define NEBOC_OPERATOR_EFFECT_RHS_LAZY 2
%define NEBOC_OPERATOR_EFFECT_EARLY_RETURN 4
%define NEBOC_OPERATOR_EFFECT_MUTATION 8
%define NEBOC_OPERATOR_EFFECT_ALL 15

%define NEBOC_OPERATOR_CAPABILITY_CORE 1
%define NEBOC_OPERATOR_CAPABILITY_DOMAIN 2
%define NEBOC_OPERATOR_CAPABILITY_MUTATION 4
%define NEBOC_OPERATOR_CAPABILITY_ALL 7

%define NEBOC_OPERATOR_IMPL_FLAG_ACTIVE 1
%define NEBOC_OPERATOR_IMPL_FLAG_INACTIVE 2
%define NEBOC_OPERATOR_IMPL_FLAG_BUILTIN 4
%define NEBOC_OPERATOR_IMPL_FLAG_USER 8
%define NEBOC_OPERATOR_IMPL_FLAG_CHECKED 16
%define NEBOC_OPERATOR_IMPL_FLAG_SHORT_CIRCUIT 32
%define NEBOC_OPERATOR_IMPL_FLAG_COMMUTATIVE 64
%define NEBOC_OPERATOR_IMPL_FLAG_COHERENT 128
%define NEBOC_OPERATOR_IMPL_FLAG_EXACT_TYPES 256

%define NEBOC_OPERATOR_IMPL_PROTOCOL_OFFSET 0
%define NEBOC_OPERATOR_IMPL_LEFT_TYPE_OFFSET 8
%define NEBOC_OPERATOR_IMPL_RIGHT_TYPE_OFFSET 16
%define NEBOC_OPERATOR_IMPL_RESULT_TYPE_OFFSET 24
%define NEBOC_OPERATOR_IMPL_OWNER_TYPE_OFFSET 32
%define NEBOC_OPERATOR_IMPL_CONSTRAINTS_OFFSET 40
%define NEBOC_OPERATOR_IMPL_REQUIRED_CAPABILITIES_OFFSET 48
%define NEBOC_OPERATOR_IMPL_EFFECTS_OFFSET 56
%define NEBOC_OPERATOR_IMPL_SPECIFICITY_OFFSET 64
%define NEBOC_OPERATOR_IMPL_FLAGS_OFFSET 72
%define NEBOC_OPERATOR_IMPL_SYMBOL_ID_OFFSET 80
%define NEBOC_OPERATOR_IMPL_SIZE 88

%define NEBOC_OPERATOR_RESOLVE_PROTOCOL_OFFSET 0
%define NEBOC_OPERATOR_RESOLVE_LEFT_TYPE_OFFSET 8
%define NEBOC_OPERATOR_RESOLVE_RIGHT_TYPE_OFFSET 16
%define NEBOC_OPERATOR_RESOLVE_AVAILABLE_CAPABILITIES_OFFSET 24
%define NEBOC_OPERATOR_RESOLVE_ALLOWED_EFFECTS_OFFSET 32
%define NEBOC_OPERATOR_RESOLVE_CANDIDATES_OFFSET 40
%define NEBOC_OPERATOR_RESOLVE_CANDIDATE_COUNT_OFFSET 48
%define NEBOC_OPERATOR_RESOLVE_OUTPUT_OFFSET 56
%define NEBOC_OPERATOR_RESOLVE_OUTPUT_INDEX_OFFSET 64
%define NEBOC_OPERATOR_RESOLVE_MATCH_COUNT_OFFSET 72
%define NEBOC_OPERATOR_RESOLVE_DIAGNOSTIC_OFFSET 80
%define NEBOC_OPERATOR_RESOLVE_SUBSTITUTIONS_OFFSET 88
%define NEBOC_OPERATOR_RESOLVE_SUBSTITUTION_COUNT_OFFSET 96
%define NEBOC_OPERATOR_RESOLVE_SIZE 104

; Generic result TypeIds use the high bit and a non-zero parameter identity.
; Resolution substitutes them through an immutable bounded map before the
; winning candidate can be published.
%define NEBOC_OPERATOR_TYPE_PARAMETER_FLAG 0x8000000000000000
%define NEBOC_OPERATOR_TYPE_PARAMETER_ID_MASK 0x7fffffffffffffff
%define NEBOC_OPERATOR_SUBSTITUTION_PARAMETER_OFFSET 0
%define NEBOC_OPERATOR_SUBSTITUTION_TYPE_OFFSET 8
%define NEBOC_OPERATOR_SUBSTITUTION_SIZE 16

; Conversion policy ABI shared by the semantic gate and its callers.
%define NEBOC_OPERATOR_CONVERSION_MODE_IMPLICIT 0
%define NEBOC_OPERATOR_CONVERSION_MODE_EXPLICIT 1
%define NEBOC_OPERATOR_CONVERSION_IDENTITY 1

; Typed lowering-plan ABI. A plan records evaluation and failure semantics
; without executing either operand during semantic resolution.
%define NEBOC_OPERATOR_LOWER_OPERATION_OFFSET 0
%define NEBOC_OPERATOR_LOWER_RESULT_TYPE_OFFSET 8
%define NEBOC_OPERATOR_LOWER_EVALUATION_ORDER_OFFSET 16
%define NEBOC_OPERATOR_LOWER_LEFT_EVALUATIONS_OFFSET 24
%define NEBOC_OPERATOR_LOWER_RIGHT_EVALUATIONS_OFFSET 32
%define NEBOC_OPERATOR_LOWER_CONTROL_FLAGS_OFFSET 40
%define NEBOC_OPERATOR_LOWER_FAILURE_POLICY_OFFSET 48
%define NEBOC_OPERATOR_LOWER_TOKEN_KIND_OFFSET 56
%define NEBOC_OPERATOR_LOWER_IMPL_SYMBOL_OFFSET 64
%define NEBOC_OPERATOR_LOWER_SIZE 72

%define NEBOC_OPERATOR_EVALUATION_LEFT_TO_RIGHT 1
%define NEBOC_OPERATOR_CONTROL_NONE 0
%define NEBOC_OPERATOR_CONTROL_RHS_LAZY 1
%define NEBOC_OPERATOR_FAILURE_NONE 0
%define NEBOC_OPERATOR_FAILURE_CHECKED 1

%define NEBOC_OPERATOR_MAX_CANDIDATES 64
%define NEBOC_OPERATOR_MAX_CONSTRAINTS 32
%define NEBOC_OPERATOR_MAX_SUBSTITUTIONS 32

%define NEBOC_OPERATOR_DIAG_NONE 0
%define NEBOC_OPERATOR_DIAG_NO_EXACT_CANDIDATE 1
%define NEBOC_OPERATOR_DIAG_AMBIGUOUS_CANDIDATE 2
%define NEBOC_OPERATOR_DIAG_IMPLICIT_CONVERSION_FORBIDDEN 3
%define NEBOC_OPERATOR_DIAG_CAPABILITY_MISSING 4
%define NEBOC_OPERATOR_DIAG_EFFECT_FORBIDDEN 5
%define NEBOC_OPERATOR_DIAG_COHERENCE_VIOLATION 6
%define NEBOC_OPERATOR_DIAG_DOMAIN_GATE_MISSING 7
%define NEBOC_OPERATOR_DIAG_LIMIT_EXCEEDED 8
%define NEBOC_OPERATOR_DIAG_SUBSTITUTION_MISSING 9
%define NEBOC_OPERATOR_DIAG_SUBSTITUTION_CONFLICT 10

%if NEBOC_OPERATOR_IMPL_SIZE & 7
 %error "operator implementation ABI must be eight-byte aligned"
%endif
%if NEBOC_OPERATOR_RESOLVE_SIZE & 7
 %error "operator resolution ABI must be eight-byte aligned"
%endif
%if NEBOC_OPERATOR_LOWER_SIZE & 7
 %error "operator lowering ABI must be eight-byte aligned"
%endif
%if NEBOC_OPERATOR_SUBSTITUTION_SIZE & 7
 %error "operator substitution ABI must be eight-byte aligned"
%endif
%if NEBOC_OPERATOR_PROTOCOL_COUNT > 64
 %error "operator protocol identity budget exceeded"
%endif

%endif
