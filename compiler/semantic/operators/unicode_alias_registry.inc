%ifndef NEBOC_UNICODE_ALIAS_REGISTRY_INC
%define NEBOC_UNICODE_ALIAS_REGISTRY_INC 1

; G125 closed Registry slice.  Each exact Unicode spelling keeps its global
; Registry identity while resolving to the same CORE semantic operation as
; its canonical ASCII token and source fixity.
%define NEBOC_UNICODE_ALIAS_REGISTRY_SCHEMA_VERSION 1
%define NEBOC_UNICODE_ALIAS_REGISTRY_ENTRY_COUNT 9

%define NEBOC_UNICODE_ALIAS_ENTRY_ID_OFFSET 0
%define NEBOC_UNICODE_ALIAS_ENTRY_CLASS_OFFSET 8
%define NEBOC_UNICODE_ALIAS_ENTRY_STATE_OFFSET 16
%define NEBOC_UNICODE_ALIAS_ENTRY_CODEPOINT_OFFSET 24
%define NEBOC_UNICODE_ALIAS_ENTRY_TOKEN_OFFSET 32
%define NEBOC_UNICODE_ALIAS_ENTRY_CONTEXTS_OFFSET 40
%define NEBOC_UNICODE_ALIAS_ENTRY_FIXITY_MASK_OFFSET 48
%define NEBOC_UNICODE_ALIAS_ENTRY_PREFIX_CORE_ID_OFFSET 56
%define NEBOC_UNICODE_ALIAS_ENTRY_INFIX_CORE_ID_OFFSET 64
%define NEBOC_UNICODE_ALIAS_ENTRY_BYTE_LENGTH_OFFSET 72
%define NEBOC_UNICODE_ALIAS_ENTRY_FLAGS_OFFSET 80
%define NEBOC_UNICODE_ALIAS_ENTRY_SIZE 88

%define NEBOC_UNICODE_ALIAS_FIXITY_PREFIX 1
%define NEBOC_UNICODE_ALIAS_FIXITY_INFIX 2

%define NEBOC_UNICODE_ALIAS_FLAG_EXACT_CODEPOINT 1
%define NEBOC_UNICODE_ALIAS_FLAG_NO_NFKC 2
%define NEBOC_UNICODE_ALIAS_FLAG_RIGHT_LAZY 4
%define NEBOC_UNICODE_ALIAS_REQUIRED_FLAGS (NEBOC_UNICODE_ALIAS_FLAG_EXACT_CODEPOINT|NEBOC_UNICODE_ALIAS_FLAG_NO_NFKC)

%if NEBOC_UNICODE_ALIAS_ENTRY_SIZE & 7
 %error "G125 Unicode alias Registry ABI must be eight-byte aligned"
%endif
%if NEBOC_OPERATOR_ID_NSR_UA_001 != 48 || NEBOC_OPERATOR_ID_NSR_UA_009 != 56
 %error "G125 Unicode alias global Registry ID drift"
%endif

%endif
