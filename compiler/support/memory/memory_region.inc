; MemoryRegion v0 owns one contiguous HostServices reservation.
; All fields are qwords and the physical size is a multiple of 16 bytes.

%define NEBOC_MEMORY_REGION_HOST_OFFSET 0
%define NEBOC_MEMORY_REGION_BASE_OFFSET 8
%define NEBOC_MEMORY_REGION_RESERVED_OFFSET 16
%define NEBOC_MEMORY_REGION_COMMITTED_OFFSET 24
%define NEBOC_MEMORY_REGION_MAXIMUM_OFFSET 32
%define NEBOC_MEMORY_REGION_OWNER_OFFSET 40
%define NEBOC_MEMORY_REGION_GENERATION_OFFSET 48
%define NEBOC_MEMORY_REGION_ACTIVE_OFFSET 56
%define NEBOC_MEMORY_REGION_FLAGS_OFFSET 64
%define NEBOC_MEMORY_REGION_SIZE 80

%define NEBOC_MEMORY_REGION_FLAG_NONE 0

; Preliminary limits. They can only change through an approved decision change.
%define NEBOC_MEMORY_REGION_DEFAULT_BYTES 1048576
%define NEBOC_MEMORY_REGION_DEFAULT_MAXIMUM_BYTES 67108864
%define NEBOC_MEMORY_REGION_HARD_MAXIMUM_BYTES 1073741824

%endif
