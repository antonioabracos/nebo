%ifndef NEBO_MF059_WIN64_TARGET_PROOF_INC
%define NEBO_MF059_WIN64_TARGET_PROOF_INC 1

; MF059 contract skeleton only. This file is not linked into neboc and does not
; activate a second target. It records the human-approved proof profile used to
; test architectural separation from the first System V/ELF/Linux target.

%define NEBO_MF059_PROOF_VERSION 0
%define NEBO_MF059_PROOF_STATE_PLAN_ONLY 1
%define NEBO_MF059_PROOF_CONTRACT_SKELETON_ONLY 1
%define NEBO_MF059_PROOF_NATIVE_EXECUTION_PRESENT 0
%define NEBO_MF059_PROOF_TARGET_SUPPORT_CERTIFIED 0
%define NEBO_MF059_PROOF_BUILD_INTEGRATION_PRESENT 0
%define NEBO_MF059_PROOF_PRODUCT_SELECTION_PRESENT 0

%define NEBO_MF059_PROOF_TARGET_ID 2
%define NEBO_MF059_PROOF_ISA_X86_64 1
%define NEBO_MF059_PROOF_EXTERNAL_ABI_WIN64 2
%define NEBO_MF059_PROOF_OBJECT_FORMAT_PECOFF 2
%define NEBO_MF059_PROOF_ENVIRONMENT_WINDOWS 2
%define NEBO_MF059_PROOF_ENDIAN_LITTLE 1

; Shared semantic data model.
%define NEBO_MF059_PROOF_POINTER_SIZE 8
%define NEBO_MF059_PROOF_POINTER_ALIGNMENT 8
%define NEBO_MF059_PROOF_INT_SIZE 8
%define NEBO_MF059_PROOF_INT_ALIGNMENT 8
%define NEBO_MF059_PROOF_BOOL_SIZE 1
%define NEBO_MF059_PROOF_BOOL_ALIGNMENT 1
%define NEBO_MF059_PROOF_STACK_ALIGNMENT 16

; Win64 external ABI mapping proof. These are deliberately separate from the
; current System V ABI adapter constants.
%define NEBO_MF059_PROOF_REGISTER_PARAMETER_COUNT 4
%define NEBO_MF059_PROOF_SHADOW_SPACE_BYTES 32
%define NEBO_MF059_PROOF_RED_ZONE_BYTES 0
%define NEBO_MF059_PROOF_INTEGER_RETURN_REGISTER_RAX 1
%define NEBO_MF059_PROOF_FIRST_INTEGER_ARGUMENT_RCX 1
%define NEBO_MF059_PROOF_SECOND_INTEGER_ARGUMENT_RDX 1
%define NEBO_MF059_PROOF_THIRD_INTEGER_ARGUMENT_R8 1
%define NEBO_MF059_PROOF_FOURTH_INTEGER_ARGUMENT_R9 1

; Missing components are explicit. A proof profile cannot be mistaken for a
; usable compiler target.
%define NEBO_MF059_PROOF_HOST_ADAPTER_IMPLEMENTED 0
%define NEBO_MF059_PROOF_EXTERNAL_ABI_EMITTER_IMPLEMENTED 0
%define NEBO_MF059_PROOF_PECOFF_FORMAT_ADAPTER_IMPLEMENTED 0
