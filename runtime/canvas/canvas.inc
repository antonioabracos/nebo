%ifndef NEBO_CANVAS_INC
%define NEBO_CANVAS_INC 1

%include "runtime/console/render/software_surface.inc"
%include "runtime/window/headless/headless_window.inc"

; CONTROLO-DE-FLUXO-ESTRUTURADO-F06 bounded Canvas 2D ABI. The first 96 bytes are exactly the
; historical SoftwareSurface descriptor, allowing the direct-X11 adapter to
; present the same caller-owned pixels without a hidden allocation. Logical
; colors are RGBA8; storage is premultiplied little-endian BGRA for the current
; X11 target. Pixel goldens are exported in canonical premultiplied RGBA byte order.
%define NEBO_CANVAS_VERSION 1
%define NEBO_CANVAS_MAGIC 0x4e42435631384636

%define NEBO_CANVAS_MIN_AXIS 1
%define NEBO_CANVAS_MAX_AXIS 2048
%define NEBO_CANVAS_MAX_PIXELS 4194304
%define NEBO_CANVAS_MAX_PIXEL_BYTES 16777216
%define NEBO_CANVAS_MAX_COMMANDS 8192
%define NEBO_CANVAS_MAX_TEXT_BYTES 4096
%define NEBO_CANVAS_COORD_MIN -4096
%define NEBO_CANVAS_COORD_MAX 4095
%define NEBO_CANVAS_MAX_RADIUS 4095

%define NEBO_CANVAS_FONT_WIDTH 5
%define NEBO_CANVAS_FONT_HEIGHT 7
%define NEBO_CANVAS_FONT_ADVANCE 6
%define NEBO_CANVAS_FONT_LINE_HEIGHT 8

; Caller-owned Canvas descriptor. Prefix 0..95 is SoftwareSurface v1.
%define NEBO_CANVAS_SURFACE_OFFSET 0
%define NEBO_CANVAS_COMMANDS_PTR_OFFSET 96
%define NEBO_CANVAS_COMMAND_CAPACITY_OFFSET 104
%define NEBO_CANVAS_COMMAND_COUNT_OFFSET 112
