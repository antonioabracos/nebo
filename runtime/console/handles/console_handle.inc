%ifndef NEBO_CONSOLE_HANDLE_INC
%define NEBO_CONSOLE_HANDLE_INC 1

; DG-006 Runtime ABI v0 ConsoleHandle.
%define NEBO_CONSOLE_RUNTIME_ABI_VERSION 0
%define NEBO_CONSOLE_HANDLE_SIZE 8
%define NEBO_CONSOLE_HANDLE_INVALID 0
%define NEBO_CONSOLE_HANDLE_SLOT_MASK 0xffffffff
%define NEBO_CONSOLE_HANDLE_GENERATION_SHIFT 32

; DG-006 PendingHandle uses the same physical u64 layout. MF041 freezes only
; the ABI constants; Pending lifecycle and behavior remain outside this front.
%define NEBO_PENDING_HANDLE_SIZE 8
%define NEBO_PENDING_HANDLE_INVALID 0
%define NEBO_PENDING_HANDLE_SLOT_MASK 0xffffffff
%define NEBO_PENDING_HANDLE_GENERATION_SHIFT 32

; Console Runtime status values returned in EAX.
%define NEBO_CONSOLE_STATUS_OK 0
%define NEBO_CONSOLE_STATUS_INVALID_ARGUMENT 1
%define NEBO_CONSOLE_STATUS_ABI_MISMATCH 2
%define NEBO_CONSOLE_STATUS_HANDLE_INVALID 3
%define NEBO_CONSOLE_STATUS_HANDLE_CLOSED 4
%define NEBO_CONSOLE_STATUS_LIMIT_EXCEEDED 5
%define NEBO_CONSOLE_STATUS_BAD_STATE 6
%define NEBO_CONSOLE_STATUS_QUEUE_FULL 7
%define NEBO_CONSOLE_STATUS_QUEUE_EMPTY 8
%define NEBO_CONSOLE_STATUS_PLATFORM_FAILURE 9
%define NEBO_CONSOLE_STATUS_NO_PROGRESS 10
%define NEBO_CONSOLE_STATUS_COUNT 11

%endif
