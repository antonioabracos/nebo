%ifndef NEBO_PLATFORM_ADAPTER_CONTRACT_INC
%define NEBO_PLATFORM_ADAPTER_CONTRACT_INC 1

%include "runtime/console/handles/console_handle.inc"
%include "runtime/console/queues/console_queue.inc"

; Platform Adapter ABI v0. Native protocol identifiers never cross this file.
%define NEBO_PLATFORM_ADAPTER_ABI_VERSION 0
%define NEBO_PLATFORM_SCALE_FRACTION_BITS 6
%define NEBO_PLATFORM_SCALE_ONE 64

%define NEBO_PLATFORM_CAP_INIT_SHUTDOWN        (1 << 0)
%define NEBO_PLATFORM_CAP_WINDOW_CREATE_DESTROY (1 << 1)
%define NEBO_PLATFORM_CAP_SOFTWARE_SURFACE     (1 << 2)
%define NEBO_PLATFORM_CAP_NORMALIZED_EVENTS    (1 << 3)
%define NEBO_PLATFORM_CAP_SCALE_BASELINE       (1 << 4)
%define NEBO_PLATFORM_CAP_OPAQUE_HANDLES       (1 << 5)
%define NEBO_PLATFORM_CAP_CUSTOM_CHROME_HINTS  (1 << 6)
%define NEBO_PLATFORM_CAP_DIRECT_NATIVE_PROTOCOL (1 << 7)
%define NEBO_PLATFORM_CAP_WINDOW_DRAG           (1 << 8)
%define NEBO_PLATFORM_CAP_WINDOW_RESIZE         (1 << 9)
%define NEBO_PLATFORM_CAP_WINDOW_MINIMIZE       (1 << 10)
%define NEBO_PLATFORM_CAP_WINDOW_MAXIMIZE_RESTORE (1 << 11)
%define NEBO_PLATFORM_CAP_WINDOW_CLOSE          (1 << 12)
%define NEBO_PLATFORM_CAP_POINTER_INPUT         (1 << 13)
%define NEBO_PLATFORM_CAP_KEYBOARD_INPUT        (1 << 14)
%define NEBO_PLATFORM_CAP_TEXT_INPUT            (1 << 15)
%define NEBO_PLATFORM_CAP_FOCUS_ACTIVATION      (1 << 16)
%define NEBO_PLATFORM_CAP_BASIC_HIDPI            (1 << 17)
%define NEBO_PLATFORM_MF051_REQUIRED_CAPABILITIES 0xff
%define NEBO_PLATFORM_MF052_REQUIRED_CAPABILITIES 0x1fff
%define NEBO_PLATFORM_MF053_REQUIRED_CAPABILITIES 0x3ffff

%define NEBO_PLATFORM_ADAPTER_STATE_EMPTY 0
%define NEBO_PLATFORM_ADAPTER_STATE_READY 1
%define NEBO_PLATFORM_ADAPTER_STATE_SHUTDOWN 2
%define NEBO_PLATFORM_ADAPTER_STATE_FAILED 3

; Platform-only statuses deliberately remain outside Console Runtime status space.
%define NEBO_PLATFORM_STATUS_OK 0
%define NEBO_PLATFORM_STATUS_INVALID_ARGUMENT 1
%define NEBO_PLATFORM_STATUS_BAD_STATE 2
%define NEBO_PLATFORM_STATUS_CAPABILITY_MISSING 256
%define NEBO_PLATFORM_STATUS_AUTH_FAILURE 257
%define NEBO_PLATFORM_STATUS_PROTOCOL_FAILURE 258
%define NEBO_PLATFORM_STATUS_IO_FAILURE 259
%define NEBO_PLATFORM_STATUS_UNSUPPORTED_FORMAT 260
%define NEBO_PLATFORM_STATUS_TIMEOUT 261
%define NEBO_PLATFORM_STATUS_NO_EVENT 262
%define NEBO_PLATFORM_STATUS_STALE_GEOMETRY 263

; Opaque window handles preserve the Console generational shape but never expose
; native protocol resource IDs. Slot 0 is reserved as invalid.
%define NEBO_PLATFORM_WINDOW_HANDLE_INVALID 0
%define NEBO_PLATFORM_WINDOW_HANDLE_SLOT_MASK 0xffffffff
%define NEBO_PLATFORM_WINDOW_HANDLE_GENERATION_SHIFT 32

; Pointer-free adapter report used by certification and audit evidence.
%define NEBO_PLATFORM_REPORT_ADAPTER_ID_HASH_OFFSET 0
%define NEBO_PLATFORM_REPORT_ABI_VERSION_OFFSET 8
%define NEBO_PLATFORM_REPORT_STATE_OFFSET 12
%define NEBO_PLATFORM_REPORT_CAPABILITIES_OFFSET 16
%define NEBO_PLATFORM_REPORT_REQUIRED_CAPABILITIES_OFFSET 24
%define NEBO_PLATFORM_REPORT_MISSING_CAPABILITIES_OFFSET 32
%define NEBO_PLATFORM_REPORT_SCALE_FACTOR_OFFSET 40
%define NEBO_PLATFORM_REPORT_FLAGS_OFFSET 48
%define NEBO_PLATFORM_REPORT_NATIVE_HANDLE_LEAKS_OFFSET 56
%define NEBO_PLATFORM_REPORT_SIZE 64
%define NEBO_PLATFORM_REPORT_QWORDS 8

%define NEBO_PLATFORM_REPORT_FLAG_DIRECT 1
%define NEBO_PLATFORM_REPORT_FLAG_CUSTOM_CHROME 2
%define NEBO_PLATFORM_REPORT_FLAG_MANAGED_WINDOW 4
%define NEBO_PLATFORM_REPORT_REQUIRED_FLAGS 7

%define NEBO_PLATFORM_EVENT_FLAG_NATIVE 1
%define NEBO_PLATFORM_EVENT_FLAG_SYNTHETIC 2

; Common input payload contract. Pointer payload0 packs signed x/y 26.6 values
; as low/high dwords. Pointer payload1 stores button in low 16 bits and common
; modifiers in bits 32..63. Key payload0 stores logical key in the low dword and
; native keycode in the high dword. Key payload1 stores common modifiers in the
; low dword and keysym in the high dword. Text payload0 contains up to four UTF-8
; bytes in little-endian order and payload1 is the byte length.
%define NEBO_PLATFORM_MOD_SHIFT   (1 << 0)
%define NEBO_PLATFORM_MOD_CONTROL (1 << 1)
%define NEBO_PLATFORM_MOD_ALT     (1 << 2)
%define NEBO_PLATFORM_MOD_SUPER   (1 << 3)

%define NEBO_PLATFORM_POINTER_BUTTON_NONE 0
%define NEBO_PLATFORM_POINTER_BUTTON_PRIMARY 1
%define NEBO_PLATFORM_POINTER_BUTTON_MIDDLE 2
%define NEBO_PLATFORM_POINTER_BUTTON_SECONDARY 3

%define NEBO_PLATFORM_KEY_UNMAPPED 0
%define NEBO_PLATFORM_KEY_LEFT 1
%define NEBO_PLATFORM_KEY_RIGHT 2
%define NEBO_PLATFORM_KEY_HOME 3
%define NEBO_PLATFORM_KEY_END 4
%define NEBO_PLATFORM_KEY_BACKSPACE 5
%define NEBO_PLATFORM_KEY_DELETE 6
%define NEBO_PLATFORM_KEY_TAB 7
%define NEBO_PLATFORM_KEY_ENTER 9

%endif
