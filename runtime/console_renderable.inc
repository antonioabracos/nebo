%define NEBO_CONSOLE_RENDER_RESULT_NODE_OFFSET 0
%define NEBO_CONSOLE_RENDER_RESULT_TYPE_OFFSET 48
%define NEBO_CONSOLE_RENDER_RESULT_KIND_OFFSET 56
