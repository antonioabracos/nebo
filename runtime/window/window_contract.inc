%define NEBO_WINDOW_TERMINAL_EVENT_RESERVE 2
%define NEBO_WINDOW_MAX_TEXT_INPUT_BYTES 4

; Generational opaque WindowHandle. Slot zero and generation zero are invalid.
%define NEBO_WINDOW_HANDLE_SIZE 8
%define NEBO_WINDOW_HANDLE_INVALID 0
%define NEBO_WINDOW_HANDLE_SLOT_MASK 0xffffffff
%define NEBO_WINDOW_HANDLE_GENERATION_SHIFT 32

