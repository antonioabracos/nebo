; WindowEvent, backend and cancellation vocabulary consumed by F04/F05. It
; does not activate a public .no parser surface and exposes no native handle.
%define NEBO_WINDOW_CONTRACT_VERSION 1

; Bounded profile.
%define NEBO_WINDOW_MAX_WINDOWS 16
%define NEBO_WINDOW_MIN_WIDTH 1
%define NEBO_WINDOW_MIN_HEIGHT 1
