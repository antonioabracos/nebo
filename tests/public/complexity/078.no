(Int.self)workflowCompatibility() { self.return; }
(Int.self)workflowInstances() { self.return; }
(Int.self)workflowTimeline() { self.return; }
(Int.self)workflowMetrics() { self.return; }
(Int.self)workflowReplay() { self.return; }
(Int.self)workflowRepair() { self.return; }
(Int.self)workflowVerify() { self.return; }

