// Table and timeline additions are observed before the dashboard is shown.
start() {
    RenderPlan;
    3303;
    output.stdout().stderr().target("domain-visual-service").plain().visual().headlessEvent();
    lifecycle.event("domain-visual").payload("dashboard-table-timeline-show").headless().jsonl().targetConformance().validate().deterministic().failureAtomic().bounded();
}
