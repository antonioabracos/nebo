// Selects the bounded migration matrix and rejects historical public facades.
start() {
    RenderPlan;
    3605;
    output.stdout().stderr().target("rf116-closeout").plain().visual().headlessEvent();
    lifecycle.event("integration-conformance").payload("change-migration-matrix").headless().jsonl().targetConformance().validate().deterministic().failureAtomic().bounded();
}
