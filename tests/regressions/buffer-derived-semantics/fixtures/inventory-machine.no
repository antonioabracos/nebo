start() {
    Buffer.withCapacity(4).stock;
    stock.push(12).push0;
    stock.push(7).push1;
    stock.push(3).push2;
    stock.push(9).push3;
    stock.length().stockLength;
    stock.capacity().stockCapacity;
    stock.at(0).stock0;
    stock.at(1).stock1;
    stock.at(2).stock2;
    stock.at(3).stock3;
    stock.view(0, 4).stockView;
    stockView.sum().fullSum;

    "NEBO_ASSERT|A|LENGTH|".console();
    stockLength.console();
    "\n".console();
    "NEBO_ASSERT|A|CAPACITY|".console();
    stockCapacity.console();
    "\n".console();
    "NEBO_ASSERT|A|AT0|".console();
    stock0.console();
    "\n".console();
    "NEBO_ASSERT|A|AT1|".console();
    stock1.console();
    "\n".console();
    "NEBO_ASSERT|A|AT2|".console();
    stock2.console();
    "\n".console();
    "NEBO_ASSERT|A|AT3|".console();
    stock3.console();
    "\n".console();
    "NEBO_ASSERT|A|FULL_SUM|".console();
    fullSum.console();
    "\n".console();

    Buffer.zeroed(4).codes;
    codes.set(0, 101).old0;
    codes.set(1, 102).old1;
    codes.set(2, 103).old2;
    codes.set(3, 104).old3;
    codes.get(2).existing;
    existing.isSome().existingSome;
    existing.isNone().existingNone;
    existing.unwrapOr(0).existingValue;
    codes.get(9).missing;
    missing.isSome().missingSome;
    missing.isNone().missingNone;
    missing.unwrapOr(255).missingValue;

    "NEBO_ASSERT|B|EXISTING_IS_SOME|".console();
    existingSome.console();
    "\n".console();
    "NEBO_ASSERT|B|EXISTING_IS_NONE|".console();
    existingNone.console();
    "\n".console();
    "NEBO_ASSERT|B|EXISTING_UNWRAP_OR|".console();
    existingValue.console();
    "\n".console();
    "NEBO_ASSERT|B|MISSING_IS_SOME|".console();
    missingSome.console();
    "\n".console();
    "NEBO_ASSERT|B|MISSING_IS_NONE|".console();
    missingNone.console();
    "\n".console();
    "NEBO_ASSERT|B|MISSING_UNWRAP_OR|".console();
    missingValue.console();
    "\n".console();

    Buffer.zeroed(4).packet;
    packet.set(0, 1).packetOld0;
    packet.set(1, 2).packetOld1;
    packet.set(2, 3).packetOld2;
    packet.set(3, 4).packetOld3;
    packet.freeze().frozen;
    frozen.byteLength().frozenLength;
    frozen.at(0).frozen0;
    frozen.at(1).frozen1;
    frozen.at(2).frozen2;
    frozen.at(3).frozen3;
    packet.at(3).source3;

    "NEBO_ASSERT|C|FROZEN_LENGTH|".console();
    frozenLength.console();
    "\n".console();
    "NEBO_ASSERT|C|FROZEN_AT0|".console();
    frozen0.console();
    "\n".console();
    "NEBO_ASSERT|C|FROZEN_AT1|".console();
    frozen1.console();
    "\n".console();
    "NEBO_ASSERT|C|FROZEN_AT2|".console();
    frozen2.console();
    "\n".console();
    "NEBO_ASSERT|C|FROZEN_AT3|".console();
    frozen3.console();
    "\n".console();
    "NEBO_ASSERT|C|SOURCE_POST_AT3|".console();
    source3.console();
    "\n".console();

    "NEBO_TEST_RESULT|PASS\n".console();
    0.return;
}
